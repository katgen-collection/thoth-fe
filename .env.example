# Base URL of the api-gateway. The thothai feature routes live under /api/v1.
# The browser authenticates against the gateway (httpOnly cookie); every call
# from this app sends credentials: 'include', so no token is attached in code.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Gateway base for the user-auth-service routes (/api/v1/auth/me|refresh|logout).
# Defaults to NEXT_PUBLIC_API_BASE_URL when unset — set it only if auth is
# served from a different host than the thothai feature routes.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8080

# The shared Katgen SSO login frontend. The /login page opens this in a popup
# pointed back at /auth-callback. Same SSO the rest of the ecosystem uses.
NEXT_PUBLIC_SSO_URL=http://localhost:3000

# Name of the session cookie the gateway sets (presence-checked by middleware).
NEXT_PUBLIC_SESSION_COOKIE=thothai_session
